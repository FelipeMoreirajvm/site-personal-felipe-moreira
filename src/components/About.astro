---
import type { Profile } from "../lib/getProfile";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section class="about container" id="sobre" aria-labelledby="about-title">
  <div class="about-text rise" style="--delay: 0.2s">
    <h2 id="about-title">Sobre</h2>
    <p>{profile.bio}</p>
  </div>

  <div class="portrait rise" style="--delay: 0.4s">
    <img
      class="photo"
      src={profile.photo.src}
      srcset={profile.photo.srcset}
      sizes="(min-width: 48rem) 18rem, 14rem"
      alt={profile.photo.alt}
      width="560"
      height="560"
    />
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  h2 {
    margin-bottom: var(--space-md);
    font-size: clamp(2.4rem, 8vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
  }

  p {
    max-width: 32rem;
    color: var(--color-text-soft);
    font-size: 1.1rem;
  }

  .portrait {
    position: relative;
    justify-self: center;
    width: min(14rem, 60vw);
    aspect-ratio: 1;
    margin: 1rem;
  }

  .portrait::before {
    content: "";
    position: absolute;
    inset: -1rem;
    border: 1px solid var(--color-blue);
    border-radius: 50%;
    opacity: 0.45;
  }

  .photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 0 6px var(--color-blue),
      0 18px 36px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 48rem) {
    .about {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
    }

    .portrait {
      width: min(18rem, 100%);
    }
  }
</style>