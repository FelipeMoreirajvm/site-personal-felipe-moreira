---
import type { Profile } from "../lib/getProfile";
import SiteNav from "./SiteNav.astro";
import EntryButtons from "./EntryButtons.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

// Primeiro nome fino, sobrenome grosso. Cada letra é animada uma a uma.
let counter = 0;
const words = profile.name.split(" ").map((word, wordIndex) => ({
  bold: wordIndex > 0,
  letters: [...word].map((letter) => ({ letter, index: counter++ })),
}));
---

<section class="hero" id="inicio" data-hero>
  <div class="parallax" aria-hidden="true">
    <div class="bg bg-settle"></div>
    <div class="bg-lit"></div>
  </div>

  <SiteNav />

  <div class="container main">
    <h1 aria-label={profile.name}>
      {
        words.map((word) => (
          <span class={`word ${word.bold ? "bold" : "light"}`} aria-hidden="true">
            {word.letters.map((item) => (
              <span class="letter" style={`--i: ${item.index}`}>
                {item.letter}
              </span>
            ))}
          </span>
        ))
      }
    </h1>

    <EntryButtons />
  </div>

  <div class="container social">
    <slot />
  </div>
</section>

<style>
  .hero {
    /* Para trocar a imagem de fundo, mude só esta linha */
    --hero-image: url("/hero-bg.jpg");
    --overlay: linear-gradient(
      90deg,
      rgba(16, 24, 40, 0.94) 0%,
      rgba(16, 24, 40, 0.62) 45%,
      rgba(16, 24, 40, 0.15) 100%
    );

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
    min-height: 100svh;
    background-color: var(--color-bg);
  }

  /* Camada de fundo que se move com o cursor (profundidade) */
  .parallax {
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translate3d(
        calc(var(--px, 0) * -14px),
        calc(var(--py, 0) * -10px),
        0
      )
      scale(1.06);
  }

  .bg {
    position: absolute;
    inset: 0;
    background:
      var(--overlay), var(--hero-image) center / cover no-repeat;
  }

  /* Lanterna: a imagem fica mais clara ao redor do cursor */
  .bg-lit {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(16, 24, 40, 0.38), rgba(16, 24, 40, 0.38)),
      var(--hero-image) center / cover no-repeat;
    -webkit-mask-image: radial-gradient(
      circle 15rem at var(--mx, 50%) var(--my, 50%),
      #000 0%,
      transparent 72%
    );
    mask-image: radial-gradient(
      circle 15rem at var(--mx, 50%) var(--my, 50%),
      #000 0%,
      transparent 72%
    );
    opacity: var(--lit, 0);
    transition: opacity 0.5s ease;
  }

  /* Nome, botões e ícones ocupam a coluna inteira, alinhados com o menu */
  .main,
  .social {
    width: 100%;
  }

  .main {
    align-self: center;
    padding-block: 2rem;
    translate: calc(var(--px, 0) * 10px) calc(var(--py, 0) * 6px);
  }

  h1 {
    font-size: clamp(3.6rem, 14vw, 8.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .word {
    display: block;
  }

  .word.light {
    font-size: 0.5em;
    font-weight: 300;
    letter-spacing: 0.08em;
  }

  .word.bold {
    font-weight: 800;
  }

  /* As letras reagem ao cursor: sobem, crescem e brilham em azul */
  .letter {
    display: inline-block;
    translate: 0 calc(var(--near, 0) * -12px);
    scale: calc(1 + var(--near, 0) * 0.06);
    text-shadow: 0 0 calc(var(--near, 0) * 26px)
      rgba(37, 99, 235, calc(var(--near, 0) * 0.9));
    transition:
      translate 0.2s ease-out,
      scale 0.2s ease-out,
      text-shadow 0.2s ease-out;
  }

  .social {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }

  @media (max-width: 47.99rem) {
    .hero {
      --overlay: linear-gradient(
        180deg,
        rgba(16, 24, 40, 0.75),
        rgba(16, 24, 40, 0.92)
      );
    }
  }
</style>