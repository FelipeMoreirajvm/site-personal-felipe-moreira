---
import type { Profile } from "../lib/getProfile";
import SiteNav from "./SiteNav.astro";
import EntryButtons from "./EntryButtons.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

// Primeiro nome fino, sobrenome grosso. Cada letra é animada uma a uma.
let counter = 0;
const words = profile.name.split(" ").map((word, wordIndex) => ({
  bold: wordIndex > 0,
  letters: [...word].map((letter) => ({ letter, index: counter++ })),
}));
---

<section class="hero" id="inicio">
  <div class="bg bg-settle" aria-hidden="true"></div>

  <SiteNav />

  <div class="container main">
    <h1 aria-label={profile.name}>
      {
        words.map((word) => (
          <span class={`word ${word.bold ? "bold" : "light"}`} aria-hidden="true">
            {word.letters.map((item) => (
              <span class="letter" style={`--i: ${item.index}`}>
                {item.letter}
              </span>
            ))}
          </span>
        ))
      }
    </h1>

    <EntryButtons />
  </div>

  <div class="container social">
    <slot />
  </div>
</section>

<style>
  .hero {
    /* Para trocar a imagem de fundo, mude só esta linha */
    --hero-image: url("/hero-bg.jpg");
    --overlay: linear-gradient(
      90deg,
      rgba(16, 24, 40, 0.94) 0%,
      rgba(16, 24, 40, 0.62) 45%,
      rgba(16, 24, 40, 0.15) 100%
    );

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
    min-height: 100svh;
    background-color: var(--color-bg);
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      var(--overlay), var(--hero-image) center / cover no-repeat;
  }

  /* Faz o nome, os botões e os ícones ocuparem a coluna inteira,
     alinhados à esquerda com o menu */
  .main,
  .social {
    width: 100%;
  }

  .main {
    align-self: center;
    padding-block: 2rem;
  }

  h1 {
    font-size: clamp(3.6rem, 14vw, 8.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .word {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .word.light {
    font-size: 0.5em;
    font-weight: 300;
    letter-spacing: 0.08em;
  }

  .word.bold {
    font-weight: 800;
  }

  .letter {
    display: inline-block;
  }

  .social {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }

  @media (max-width: 47.99rem) {
    .hero {
      --overlay: linear-gradient(
        180deg,
        rgba(16, 24, 40, 0.75),
        rgba(16, 24, 40, 0.92)
      );
    }
  }
</style>