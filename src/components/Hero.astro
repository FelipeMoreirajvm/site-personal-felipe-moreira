---
import { Image } from "astro:assets";
import type { Profile } from "../lib/getProfile";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

// Separa o nome em palavras e letras para animar uma a uma
let counter = 0;
const words = profile.name
  .split(" ")
  .map((word) => [...word].map((letter) => ({ letter, index: counter++ })));
---

<section class="hero">
  <div class="portrait" data-tilt>
    <span class="ring ring-static" aria-hidden="true"></span>
    <span class="ring ring-pulse" aria-hidden="true"></span>
    <Image
      class="photo"
      src={profile.photo}
      alt={profile.photoAlt}
      width={560}
      height={560}
      loading="eager"
    />
  </div>

  <div class="text">
    <h1 aria-label={profile.name}>
      {
        words.map((word) => (
          <span class="word" aria-hidden="true">
            {word.map((item) => (
              <span class="letter" style={`--i: ${item.index}`}>
                {item.letter}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="profession rise" style="--delay: 0.9s">{profile.profession}</p>
    <p class="bio rise" style="--delay: 1.05s">{profile.bio}</p>
    <div class="actions rise" style="--delay: 1.2s">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    align-items: center;
  }

  .portrait {
    position: relative;
    justify-self: center;
    width: min(11rem, 46vw);
    aspect-ratio: 1;
    margin: 1.4rem;
    transform: perspective(800px) rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg));
    transition: transform 0.25s ease-out;
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--color-blue);
    pointer-events: none;
  }

  .ring-static {
    inset: -0.85rem;
    opacity: 0.4;
  }

  .ring-pulse {
    inset: -0.15rem;
    opacity: 0;
  }

  .photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    /* contorno fino em azul elétrico, separado da foto por uma folga escura */
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 0 6px var(--color-blue),
      0 18px 36px rgba(0, 0, 0, 0.35);
  }

  .word {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .letter {
    display: inline-block;
  }

  h1 {
    color: var(--color-text);
    font-size: clamp(3rem, 13vw, 6.5rem);
    font-weight: 800;
    line-height: 0.95;
  }

  .profession {
    margin-top: var(--space-md);
    color: var(--color-gold);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .bio {
    margin-top: var(--space-sm);
    max-width: 28rem;
    color: var(--color-text-soft);
  }

  .actions {
    margin-top: var(--space-md);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 3rem;
    }

    .portrait {
      order: 2;
      width: min(20rem, 100%);
      margin: 2rem;
    }
  }
</style>

<script>
  // Inclinação bem suave da foto acompanhando o mouse (só em computador)
  const portrait = document.querySelector<HTMLElement>("[data-tilt]");
  const canTilt = window.matchMedia(
    "(prefers-reduced-motion: no-preference) and (hover: hover)",
  ).matches;

  if (portrait && canTilt) {
    window.addEventListener("pointermove", (event) => {
      const x = event.clientX / window.innerWidth - 0.5;
      const y = event.clientY / window.innerHeight - 0.5;
      portrait.style.setProperty("--ry", `${x * 8}deg`);
      portrait.style.setProperty("--rx", `${-y * 8}deg`);
    });
  }
</script>