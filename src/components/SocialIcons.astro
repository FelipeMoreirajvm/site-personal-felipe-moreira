---
import type { SocialLink } from "../lib/getProfile";
import { getIcon, isHighlighted } from "../lib/social";

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <nav aria-label="Redes sociais">
      <ul>
        {links.map((link, index) => {
          const icon = getIcon(link.platform);
          const highlighted = isHighlighted(link);
          return (
            <li class="pop" style={`--delay: ${1.2 + index * 0.1}s`}>
              <a
                class:list={[
                  "icon-btn",
                  highlighted && "primary shine",
                  !icon && "text",
                ]}
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.platform} (abre em nova aba)`}
                title={link.platform}
                data-magnet
              >
                {icon ? (
                  <svg
                    class={icon.kind}
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                    set:html={icon.markup}
                  />
                ) : (
                  link.platform
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .icon-btn {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid rgba(248, 250, 252, 0.5);
    border-radius: 999px;
    background-color: rgba(16, 24, 40, 0.35);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    /* puxada magnética em direção ao cursor */
    translate: var(--tx, 0px) var(--ty, 0px);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease,
      translate 0.15s ease-out;
  }

  .icon-btn.text {
    width: auto;
    padding: 0 1.2rem;
  }

  .icon-btn:hover {
    border-color: var(--color-blue);
    background-color: var(--color-blue);
    transform: translateY(-2px);
  }

  svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  svg.stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  svg.fill {
    fill: currentColor;
    stroke: none;
  }

  /* Botão destacado (WhatsApp): maior, dourado e com aura mais forte */
  .primary {
    width: 3.4rem;
    height: 3.4rem;
    border-color: var(--color-gold);
    background-color: var(--color-gold);
    color: var(--color-bg);
    box-shadow: 0 0 34px rgba(245, 185, 66, 0.6);
  }

  .primary svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .primary:hover {
    border-color: #f8c968;
    background-color: #f8c968;
  }

  @media (prefers-reduced-motion: no-preference) {
    .primary {
      animation: wa-aura 2.2s ease-out infinite;
    }
  }
</style>

<style is:global>
  @keyframes wa-aura {
    0% {
      box-shadow:
        0 0 0 0 rgba(245, 185, 66, 0.8),
        0 0 34px rgba(245, 185, 66, 0.6);
    }
    70%,
    100% {
      box-shadow:
        0 0 0 28px rgba(245, 185, 66, 0),
        0 0 34px rgba(245, 185, 66, 0.6);
    }
  }
</style>