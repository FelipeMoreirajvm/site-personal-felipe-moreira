---
import type { SocialLink } from "../lib/getProfile";

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;

// Desenhos (viewBox 24x24). A chave é o nome da rede em minúsculas.
const icons: Record<string, string> = {
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
};
---

{
  links.length > 0 && (
    <nav aria-label="Redes sociais">
      <ul>
        {links.map((link, index) => {
          const icon = icons[link.platform.trim().toLowerCase()];
          return (
            <li>
              <a
                class:list={[
                  "icon-btn",
                  index === 0 && "primary cta shine",
                  !icon && "text",
                ]}
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.platform} (abre em nova aba)`}
                title={link.platform}
              >
                {icon ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icon} />
                ) : (
                  link.platform
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .icon-btn {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid rgba(248, 250, 252, 0.5);
    border-radius: 999px;
    background-color: rgba(16, 24, 40, 0.35);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .icon-btn.text {
    width: auto;
    padding: 0 1.2rem;
  }

  .icon-btn:hover {
    border-color: var(--color-blue);
    background-color: var(--color-blue);
    transform: translateY(-2px);
  }

  .icon-btn svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Botão principal: dourado */
  .primary {
    border-color: var(--color-gold);
    background-color: var(--color-gold);
    color: var(--color-bg);
  }

  .primary:hover {
    border-color: #f8c968;
    background-color: #f8c968;
  }
</style>