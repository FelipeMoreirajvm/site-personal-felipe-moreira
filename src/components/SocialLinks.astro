---
import type { SocialLink } from "../lib/getProfile";
import { isHighlighted } from "../lib/social";

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <nav aria-label="Redes sociais">
      <ul>
        {links.map((link) => (
          <li>
            <a
              class:list={["btn", isHighlighted(link) && "primary cta shine"]}
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.platform}
              <span class="sr-only"> (abre em nova aba)</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    ul {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .btn {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.7rem;
    border: 1px solid var(--color-blue);
    border-radius: 999px;
    background-color: var(--color-surface);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .btn:hover {
    background-color: var(--color-blue);
    transform: translateY(-2px);
  }

  .primary {
    border-color: var(--color-gold);
    background-color: var(--color-gold);
    color: var(--color-bg);
  }

  .primary:hover {
    background-color: #f8c968;
    border-color: #f8c968;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>