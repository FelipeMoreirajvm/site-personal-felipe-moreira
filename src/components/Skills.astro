---
interface Props {
  skills: string[];
}

const { skills } = Astro.props;
---

{
  skills.length > 0 && (
    <section id="tecnologias" aria-labelledby="skills-title">
      <h2 id="skills-title" class="reveal">
        Linguagens e tecnologias
      </h2>
      <ul>
        {skills.map((skill, index) => (
          <li class="reveal" style={`--delay: ${index * 0.08}s`}>
            <span class="circle float" style={`--float-delay: ${-index * 0.7}s`}>
              {skill}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  section {
    padding: 4.5rem 0;
  }

  h2 {
    margin-bottom: var(--space-lg);
    font-size: clamp(2rem, 7vw, 3.6rem);
    font-weight: 800;
    line-height: 1.05;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.75rem;
    height: 6.75rem;
    padding: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-weight: 800;
    font-size: 0.95rem;
    text-align: center;
    overflow-wrap: anywhere;
    box-shadow:
      0 0 0 5px var(--color-bg-deep),
      0 0 0 7px var(--color-sun);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  li:hover .circle {
    background-color: var(--color-sun);
    color: var(--color-ink);
  }
</style>