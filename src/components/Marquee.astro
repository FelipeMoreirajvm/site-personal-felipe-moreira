---
interface Props {
  items: string[];
}

const { items } = Astro.props;

// Repete os itens para a faixa nunca ficar com buraco, mesmo em telas largas
const half = Array.from({ length: 4 }, () => items).flat();
const loop = [...half, ...half];
---

<div class="wrap" aria-hidden="true">
  <div class="marquee">
    <div class="marquee-track">
      {loop.map((item) => <span class="item">{item}</span>)}
    </div>
  </div>
</div>

<style>
  .wrap {
    overflow: hidden;
    padding: 1.75rem 0;
  }

  .marquee {
    margin: 0 -3rem;
    padding: 0.9rem 0;
    background-color: var(--color-sun);
    color: var(--color-ink);
    transform: rotate(-2deg);
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .item::after {
    content: "✦";
    font-size: 0.7em;
  }
</style>