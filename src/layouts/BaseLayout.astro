---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import "../styles/animations.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101828" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="curtain" data-curtain transition:persist="curtain" aria-hidden="true">
      <span class="shutter top"></span>
      <span class="shutter bottom"></span>
      <span class="line"></span>
    </div>
    <slot />
  </body>
</html>

<script>
  // A cortina fica escondida depois de tocar. Como ela persiste entre páginas,
  // não volta a aparecer ao navegar.
  const curtain = document.querySelector<HTMLElement>("[data-curtain]");

  if (curtain) {
    curtain.addEventListener("animationend", (event) => {
      const target = event.target as HTMLElement;
      if (target.classList.contains("shutter")) {
        curtain.classList.add("is-done");
      }
    });

    // Depois que toda a entrada terminou, as próximas páginas não esperam mais
    window.setTimeout(() => curtain.setAttribute("data-late", ""), 3500);
  }
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* Troca de página: a antiga some desfocando, a nova é revelada de cima para baixo */
    ::view-transition-old(root) {
      animation: 0.45s ease-in both vt-out;
    }

    ::view-transition-new(root) {
      animation: 0.75s cubic-bezier(0.22, 1, 0.36, 1) both vt-in;
    }

    /* Elementos que se transformam (botão da tela inicial vira o cabeçalho da aba) */
    ::view-transition-group(*) {
      animation-duration: 0.7s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes vt-out {
      to {
        opacity: 0;
        transform: scale(0.97);
        filter: blur(6px);
      }
    }

    @keyframes vt-in {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>