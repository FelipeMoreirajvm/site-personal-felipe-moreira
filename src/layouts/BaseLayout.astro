---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import "../styles/animations.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101828" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="ambient" data-ambient transition:persist="ambient" aria-hidden="true"></div>
    <div class="cursor" data-cursor transition:persist="cursor" aria-hidden="true"></div>

    <div class="intro" data-intro transition:persist="intro" aria-hidden="true">
      <div class="frame">
        <span class="corner tl"></span>
        <span class="corner tr"></span>
        <span class="corner bl"></span>
        <span class="corner br"></span>
        <span class="rec"><i></i>REC</span>
        <span class="count"></span>
      </div>
      <span class="focus"></span>
    </div>

    <slot />
  </body>
</html>

<script>
  import "../scripts/interactions";

  // A abertura some depois de tocar. Como ela persiste entre páginas,
  // não volta a aparecer ao trocar de aba.
  const intro = document.querySelector<HTMLElement>("[data-intro]");

  if (intro) {
    intro.addEventListener("animationend", (event) => {
      if (event.animationName === "intro-resolve") {
        intro.classList.add("is-done");
      }
    });

    // Depois que toda a entrada terminou, as próximas páginas não esperam mais
    window.setTimeout(() => intro.setAttribute("data-late", ""), 4500);
  }
</script>

<style is:global>
  /* Brilho suave que acompanha o cursor em todas as páginas */
  .ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      34rem circle at var(--ax, 70%) var(--ay, 20%),
      rgba(37, 99, 235, 0.14),
      transparent 70%
    );
  }

  /* Anel que segue o cursor (só com mouse) */
  .cursor {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1100;
    width: 2.2rem;
    height: 2.2rem;
    margin: -1.1rem 0 0 -1.1rem;
    border: 1px solid rgba(248, 250, 252, 0.55);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      width 0.25s ease,
      height 0.25s ease,
      margin 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cursor {
      display: block;
    }
  }

  .cursor.is-on {
    opacity: 1;
  }

  .cursor.is-link {
    width: 3.6rem;
    height: 3.6rem;
    margin: -1.8rem 0 0 -1.8rem;
    border-color: var(--color-blue);
    background-color: rgba(37, 99, 235, 0.18);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Troca de página: a antiga some desfocando, a nova é revelada de cima para baixo */
    ::view-transition-old(root) {
      animation: 0.45s ease-in both vt-out;
    }

    ::view-transition-new(root) {
      animation: 0.75s cubic-bezier(0.22, 1, 0.36, 1) both vt-in;
    }

    /* Elementos que se transformam (botão da tela inicial vira o cabeçalho da aba) */
    ::view-transition-group(*) {
      animation-duration: 0.7s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes vt-out {
      to {
        opacity: 0;
        transform: scale(0.97);
        filter: blur(6px);
      }
    }

    @keyframes vt-in {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>