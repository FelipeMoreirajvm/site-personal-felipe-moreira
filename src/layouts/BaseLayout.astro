---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import "../styles/animations.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Títulos da abertura (cores: software = azul, film = dourado, name = branco)
const introWords = [
  { text: "Engenheiro de Software", theme: "software" },
  { text: "Filmmaker", theme: "film" },
  { text: "Felipe Moreira", theme: "name" },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101828" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <canvas class="field" data-field transition:persist="field" aria-hidden="true"></canvas>

    <div class="intro" data-intro transition:persist="intro" aria-hidden="true">
      {
        introWords.map((word, index) => (
          <span class={`intro-word ${word.theme}`} style={`--i: ${index}`}>
            {word.text}
          </span>
        ))
      }
    </div>

    <slot />
  </body>
</html>

<script>
  import "../scripts/interactions";

  // A abertura some depois de tocar. Como ela persiste entre páginas,
  // não volta a aparecer ao trocar de aba.
  const intro = document.querySelector<HTMLElement>("[data-intro]");

  if (intro) {
    intro.addEventListener("animationend", (event) => {
      if (event.animationName === "intro-dissolve") {
        intro.classList.add("is-done");
      }
    });

    // Depois que toda a entrada terminou, as próximas páginas não esperam mais
    window.setTimeout(() => intro.setAttribute("data-late", ""), 5000);
  }
</script>

<style is:global>
  /* Campo de pontos que reage ao cursor (só com mouse) */
  .field {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 900;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .field {
      display: block;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Troca de página: a antiga some desfocando, a nova é revelada de cima para baixo */
    ::view-transition-old(root) {
      animation: 0.45s ease-in both vt-out;
    }

    ::view-transition-new(root) {
      animation: 0.75s cubic-bezier(0.22, 1, 0.36, 1) both vt-in;
    }

    /* Elementos que se transformam (botão da tela inicial vira o cabeçalho da aba) */
    ::view-transition-group(*) {
      animation-duration: 0.7s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes vt-out {
      to {
        opacity: 0;
        transform: scale(0.97);
        filter: blur(6px);
      }
    }

    @keyframes vt-in {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>